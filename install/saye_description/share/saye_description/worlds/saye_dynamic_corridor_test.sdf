              <size>2 0.25 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2 0.25 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Side alcove back walls (left) -->
    <model name="left_alcove1_back">
      <static>true</static>
      <pose>7 4.5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.25 2 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.25 2 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.6 0.65 1</ambient>
            <diffuse>0.55 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="left_alcove2_back">
      <static>true</static>
      <pose>15 4.5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.25 2 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.25 2 2</size>
            </box>
