    <!-- Alcove boundary short walls -->
    <model name="left_alcove1_front">
      <static>true</static>
      <pose>6 3.75 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.25 1.5 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.25 1.5 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.58 0.65 1</ambient>
            <diffuse>0.5 0.58 0.65 1</diffuse>
          </material>
