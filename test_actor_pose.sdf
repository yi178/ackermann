<?xml version="1.0"?>
<sdf version="1.9">
  <world name="test_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <actor name="test_pedestrian">
      <pose>0 0 1.0 0 0 0</pose>
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Actor walking/files/meshes/walk.dae</filename>
      </skin>
      <animation name="walking">
        <filename>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Actor walking/files/meshes/walk.dae</filename>
      </animation>
      <script>
        <loop>true</loop>
        <trajectory id="0" type="walking">
          <waypoint><time>0</time><pose>0 0 0 0 0 0</pose></waypoint>
          <waypoint><time>5</time><pose>5 0 0 0 0 0</pose></waypoint>
        </trajectory>
      </script>

      <!-- 报告中声称这个配置可行 -->
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <update_frequency>30</update_frequency>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
      </plugin>
    </actor>
  </world>
</sdf>
