<?xml version="1.0"?>
<sdf version="1.9">
  <world name="actor_pose_bridge_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <plugin filename="libactor_pose_publisher_system.so"
            name="saye::ActorPosePublisherSystem">
      <topic_prefix>/actor_pose</topic_prefix>
      <publish_rate>20.0</publish_rate>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <actor name="test_actor">
      <pose>2 0 1.0 0 0 0</pose>
      <skin>
        <filename>model://walking_actor/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>model://walking_actor/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <plugin filename="libtest_actor_driver_system.so"
              name="saye::TestActorDriverSystem">
        <actor_name>test_actor</actor_name>
        <radius>3.0</radius>
        <speed>0.4</speed>
        <height>1.0</height>
      </plugin>
    </actor>
  </world>
</sdf>
