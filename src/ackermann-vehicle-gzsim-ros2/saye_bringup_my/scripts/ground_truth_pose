#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import TransformStamped
from tf2_msgs.msg import TFMessage
from tf2_ros import TransformBroadcaster, StaticTransformBroadcaster


class GroundTruthPose(Node):
    """Publish map->odom and odom->base_link transforms using Gazebo ground truth."""

    def __init__(self) -> None:
        super().__init__('ground_truth_pose')

        self.declare_parameter('target_frame', 'saye/base_link')
        self.declare_parameter('source_frame', '')
        self.declare_parameter('odom_frame', 'odom')
        self.declare_parameter('map_frame', 'map')
        self.declare_parameter('tf_topic', '/tf')

        self._target_frame = self.get_parameter('target_frame').get_parameter_value().string_value
        self._source_frame = self.get_parameter('source_frame').get_parameter_value().string_value
        self._odom_frame = self.get_parameter('odom_frame').get_parameter_value().string_value
        self._map_frame = self.get_parameter('map_frame').get_parameter_value().string_value
        self._tf_topic = self.get_parameter('tf_topic').get_parameter_value().string_value

        self._tf_pub = TransformBroadcaster(self)
        self._static_pub = StaticTransformBroadcaster(self)
        self._source_frame_filter = self.get_parameter('source_frame').get_parameter_value().string_value
        self._tf_sub = self.create_subscription(
            TFMessage,
            self._tf_topic,
            self._tf_callback,
            10,
        )

        static_tf = TransformStamped()
        static_tf.header.stamp = self.get_clock().now().to_msg()
        static_tf.header.frame_id = self._map_frame
        static_tf.child_frame_id = self._odom_frame
        static_tf.transform.rotation.w = 1.0
        self._static_pub.sendTransform(static_tf)
        self.get_logger().info('Published static identity transform map->odom.')

        self.get_logger().info(
            f'GroundTruthPose listening on {self._tf_topic} for *->{self._target_frame} transforms'
        )

    def _tf_callback(self, msg: TFMessage) -> None:
        for transform in msg.transforms:
            if transform.child_frame_id != self._target_frame:
                continue
            if self._source_frame_filter and transform.header.frame_id != self._source_frame_filter:
                continue
            self._publish_ground_truth(transform)

    def _publish_ground_truth(self, transform: TransformStamped) -> None:
        odom_tf = TransformStamped()
        odom_tf.header.stamp = transform.header.stamp
        odom_tf.header.frame_id = self._odom_frame
        odom_tf.child_frame_id = self._target_frame
        odom_tf.transform = transform.transform
        self._tf_pub.sendTransform(odom_tf)


def main(args=None) -> None:
    rclpy.init(args=args)
    node = GroundTruthPose()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
